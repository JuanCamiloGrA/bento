{
  "name": "bento-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure cross-platform desktop host for Bento",
  "productName": "Bento",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22 <26"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "npm --prefix ../web run build && node scripts/copy-renderer.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build": "npm run clean && npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/check-toolchain.mjs && npm run build:sidecar && npm run build && electron-forge package",
    "make": "node scripts/check-toolchain.mjs && npm run build:sidecar && npm run build && electron-forge make",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "22.15.30",
    "electron": "43.4.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller@5.4.4": true
  }
}
